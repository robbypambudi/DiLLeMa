# Backend URL (DiLLeMa dashboard API; local default is :8080 when `dillema serve` uses :8000)
BACKEND_URL=http://localhost:8080

PREFIX_DIR_MODEL=models

EMBED_MODEL_NAME=intfloat/multilingual-e5-small
DOCUMENT_PATH=documents
BASE_KNOWLEDGE_DOCUMENT_DIR=ITS-profile
BASE_KNOWLEDGE_DOCUMENT_NAME=ITS-Profile.pdf
TEXT_GENERATION_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# OpenAI-compatible LLM endpoint (e.g. served by DiLLeMa `dillema serve`).
# Point base_url at your DiLLeMa API host; api_key can be any non-empty string
# for a local vLLM/DiLLeMa deployment that doesn't enforce auth.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=any
# Must match `dillema serve --model-id`
LLM_MODEL=qwen-7b

# JWT auth (keep SECRET_KEY stable across restarts)
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Qdrant vector store
QDRANT_HOST=localhost
QDRANT_PORT=6333

# CORS: comma-separated list of allowed frontend origins.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# DiLLeMa v2 knowledge graph pilot. Apply Alembic migrations before enabling.
# Also enable a schema per collection in Admin > Collection > Knowledge graph.
KG_ENABLED=false
# Optional overrides; defaults inherit LLM_BASE_URL / LLM_API_KEY / LLM_MODEL.
# KG_LLM_BASE_URL=http://localhost:8000/v1
# KG_LLM_API_KEY=any
# KG_LLM_MODEL=qwen-7b
KG_MAX_CHUNKS=200
KG_MAX_OUTPUT_TOKENS=4096
KG_RETRIEVAL_LIMIT=12
# Set json_schema only when the inference server supports constrained JSON output.
KG_EXTRACTION_FORMAT=text
