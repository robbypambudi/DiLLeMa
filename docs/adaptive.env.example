# Merge selected entries into the repository .env, then restart the API.
# Existing LLM_BASE_URL/LLM_API_KEY/LLM_MODEL and QDRANT_* settings still apply.
ADAPTIVE_ROUTING__AGENTIC_COMPLEXITY_THRESHOLD=0.65
ADAPTIVE_ROUTING__RETRIEVAL_CONFIDENCE_THRESHOLD=0.55
ADAPTIVE_ROUTING__COVERAGE_THRESHOLD=0.6
ADAPTIVE_RETRIEVAL__TOP_K=8
ADAPTIVE_RETRIEVAL__CANDIDATES=40
ADAPTIVE_RETRIEVAL__RERANK=true
ADAPTIVE_RETRIEVAL__RETRIES=1
ADAPTIVE_RETRIEVAL__EMBEDDING_CONCURRENCY=1
ADAPTIVE_RETRIEVAL__RERANKER_CONCURRENCY=1
ADAPTIVE_RETRIEVAL__VECTOR_CONCURRENCY=8
ADAPTIVE_RETRIEVAL__LLM_CONCURRENCY=4
ADAPTIVE_MAX_INFLIGHT_REQUESTS=32
ADAPTIVE_LIMITS__MAX_AGENT_STEPS=4
ADAPTIVE_LIMITS__MAX_RETRIEVAL_CALLS=5
ADAPTIVE_LIMITS__MAX_LLM_CALLS=6
ADAPTIVE_LIMITS__MAX_INPUT_TOKENS=12000
ADAPTIVE_LIMITS__MAX_OUTPUT_TOKENS=768
ADAPTIVE_LIMITS__MAX_TOTAL_TOKENS=20000
ADAPTIVE_LIMITS__MAX_DOCUMENTS_PER_STEP=8
ADAPTIVE_LIMITS__MAX_EVIDENCE_DOCUMENTS=16
ADAPTIVE_LIMITS__TIMEOUT_MS=15000
ADAPTIVE_LATENCY__DIRECT_LLM_TARGET_MS=3000
ADAPTIVE_LATENCY__RAG_TARGET_MS=6000
ADAPTIVE_LATENCY__AGENTIC_RAG_TARGET_MS=12000
ADAPTIVE_LATENCY__GLOBAL_REQUEST_TIMEOUT_MS=15000
ADAPTIVE_LATENCY__GENERATION_RESERVE_MS=2000
ADAPTIVE_LATENCY__DEPENDENCY_TIMEOUT_MS=4000
ADAPTIVE_CONTENT_LOGGING=false
ADAPTIVE_METRICS_LOGGING=true
ADAPTIVE_METRICS_ENABLED=true
ADAPTIVE_CACHE__EMBEDDING_ENTRIES=128
ADAPTIVE_CACHE__EMBEDDING_TTL_SECONDS=300
# Supply YOUR provider/infrastructure rates. Omitted rates produce null cost,
# not an invented price or a misleading $0. Explicit zero means no marginal fee.
# ADAPTIVE_PRICING__INPUT_PER_MILLION_USD=...
# ADAPTIVE_PRICING__OUTPUT_PER_MILLION_USD=...
# ADAPTIVE_PRICING__EMBEDDING_CALL_USD=...
# ADAPTIVE_PRICING__RETRIEVAL_OPERATION_USD=...
# ADAPTIVE_PRICING__RERANKER_OPERATION_USD=...
