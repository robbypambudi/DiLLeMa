# DiLLeMa configuration — the ONE .env for the whole repository.
# Copy to DiLLeMa/.env. It is read by the `dillema` CLI (serve/head/dashboard),
# the dashboard API (apps/) and the web app (apps/web, via vite.config.ts).
# There is no apps/.env or apps/web/.env any more; an old apps/.env is still
# read for keys missing here, with a warning, until you move them.

# Dashboard API URL as seen by the BROWSER. Leave empty: the web app then calls
# same-origin `/api` and the Vite dev server proxies it to the API that
# `dillema dashboard` started (:8080 by default). A localhost/127.0.0.1 value
# breaks the dashboard for anyone opening it from another machine; set a
# public URL here only when the API is served on a different origin.
BACKEND_URL=

PREFIX_DIR_MODEL=models

# Dense retriever for Indonesian/English RAG. E5 needs query:/passage: prefixes.
# Changing this requires recreating the Qdrant collection and re-uploading files.
EMBED_MODEL_NAME=intfloat/multilingual-e5-base
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
# CPU-only deployments: the 568M reranker above manages ~3 pairs/s, so a
# question with 40 candidates and 2 phrasings spends ~28s ranking. Naming a
# small multilingual cross-encoder here prunes the candidates first and the
# large model scores only RERANK_PREFILTER_KEEP of them: measured 2.4x faster,
# or 3.5x with RERANK_QUANTIZE, finding the same answers (24/26 on the golden
# set, identical to scoring every candidate). Keep 12 and 20 both cost nothing
# in recall; 8 starts losing answers. Scores still come from the large model,
# so every threshold below stays valid.
# Leave empty to score every candidate with the large model, as before.
RERANK_PREFILTER_MODEL=
RERANK_PREFILTER_KEEP=12
# Int8 the reranker on CPU (~1.4x alone, and it stacks with the prefilter).
# Ignored on GPU, where dynamic quantization does not apply.
RERANK_QUANTIZE=false
# Cross-encoder relevance floor (0..1). Evidence scoring below this is dropped,
# so a question the corpus cannot answer is answered with "not enough
# information" instead of the least-bad chunk. Raise it if answers cite weak
# sources; lower it if valid questions start coming back unanswered.
RERANK_MIN_SCORE=0.05
RETRIEVAL_CANDIDATES=40
RERANK_RELATIVE_FLOOR=0.5
QUERY_AUGMENTATION=true
DOCUMENT_PATH=documents
BASE_KNOWLEDGE_DOCUMENT_DIR=ITS-profile
BASE_KNOWLEDGE_DOCUMENT_NAME=ITS-Profile.pdf
TEXT_GENERATION_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# OpenAI-compatible LLM endpoint (e.g. served by DiLLeMa `dillema serve`).
# Point base_url at your DiLLeMa API host; api_key can be any non-empty string
# for a local vLLM/DiLLeMa deployment that doesn't enforce auth.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=any
# Read by `dillema serve` (flags override these).
LLM_MODEL=qwen-7b
LLM_MODEL_SOURCE=Qwen/Qwen2.5-0.5B-Instruct
# Caps chat completion so small models cannot stream forever.
LLM_MAX_TOKENS=768

# JWT auth (keep SECRET_KEY stable across restarts)
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Qdrant vector store
QDRANT_HOST=localhost
QDRANT_PORT=6333

# CORS: comma-separated list of allowed frontend origins.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# DiLLeMa v2 knowledge graph pilot. Apply Alembic migrations before enabling.
# Also enable a schema per collection in Admin > Collection > Knowledge graph.
KG_ENABLED=false
# Optional overrides; defaults inherit LLM_BASE_URL / LLM_API_KEY / LLM_MODEL.
# KG_LLM_BASE_URL=http://localhost:8000/v1
# KG_LLM_API_KEY=any
# KG_LLM_MODEL=qwen-7b
KG_MAX_CHUNKS=200
KG_MAX_OUTPUT_TOKENS=4096
KG_RETRIEVAL_LIMIT=12
# Set json_schema only when the inference server supports constrained JSON output.
KG_EXTRACTION_FORMAT=text
